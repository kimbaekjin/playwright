{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "baseUrl": ".",

    "paths": {
      "@pages/*": ["src/pages/*"],
      "@fixtures/*": ["src/fixtures/*"],
      "@utils/*": ["src/utils/*"],
      "@data/*": ["data/*"],
      "@auth/*": ["auth/*"]
    },

    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "node"
  }
}